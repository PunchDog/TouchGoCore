{
    "redis": {
        "说明:": "这里是redis配置(必填)",
        "redis_host": "127.0.0.1:6379",
        "redis_password": "",
        "redis_db": 0,
        "redis_pool_size": 256
    },
    "mysql": {
        "说明:": "这里是mysql配置",
        "db_host": "127.0.0.1:3306",
        "db_username": "root",
        "db_password": "change-me",
        "db_name": "example",
        "db_max_idle_conns": 100,
        "db_max_open_conns": 500
    },
    "mongo": {
        "说明:": "这里是mongo配置",
        "db_host": "127.0.0.1:27017",
        "db_username": "",
        "db_password": "",
        "db_name": "example",
        "db_replica_set_name": "",
        "mongo_up_url": "mongodb://%s:%s@%s/%s",
        "mongo_url": "mongodb://%s/%s",
        "init_dbtable_index": [
            {
                "table": "user",
                "index": [
                    "id",
                    "username"
                ]
            }
        ]
    },
    "web": {
        "说明": "这是一个web框架使用的配置",
        "httpport": 1000,
        "static": "文件夹路径",
        "allow_origins": ["https://example.com"],
        "tls": {
            "tls说明": "直连 HTTPS；前置 Nginx 终结 TLS 时保持 enable=false",
            "enable": false,
            "cert_file": "conf/server.crt",
            "key_file": "conf/server.key"
        }
    },
    "ws": {
        "说明:": "这里是websocket配置,作为服务器监听配置,多个端口用|分割",
        "port": [
            {
                "port": 8000,
                "callbackclassname说明": "端口对应的回调类的名字例：GateMsg,对应实现代码应为type GateMsg struct{websocket.ICall}，情具体实现ICall接口需要的函数",
                "callbackclassname": "GateMsg"
            }
        ],
        "url": "/ws",
        "inurl": "/ws",
        "allowed_origins": [
            "https://example.com"
        ],
        "check_origin": true,
        "skip_origin_for_intranet": false,
        "trusted_proxies": ["127.0.0.1"],
        "worker_pool_size": 0,
        "shard_by_key": false,
        "auth_token_header": "X-Auth-Token",
        "auth_token_query": "",
        "auth_intranet_skip": false,
        "tls": {
            "tls说明": "直连 WSS；前置反代终结 TLS 时保持 enable=false",
            "enable": false,
            "cert_file": "conf/server.crt",
            "key_file": "conf/server.key"
        }
    },
    "rpc_port": {
        "rpc_port说明": "rpc_port是监听端口,如果不填,则不开rpc服务",
        "server说明": "作为服务器监听端口",
        "server": [
            {
                "name": "其他服来连接时查询的名字，通过这个名字查找端口",
                "port": 7000,
                "adr说明": "其他服来连接这个服务器时使用的IP",
                "addr": "127.0.0.1",
                "use_tls": false
            }
        ],
        "client说明": "作为客户端连接的端口",
        "client": [
            {
                "name": "其他服来连接时查询的名字，通过这个名字查找端口",
                "port": 7000,
                "addr": "127.0.0.1",
                "use_tls": false
            }
        ],
        "tls": {
            "tls说明": "RpcConfig 的 TLS 配置，仅当 server/client 的 use_tls 为 true 时生效",
            "cert_file": "conf/server.crt",
            "key_file": "conf/server.key",
            "enable": false,
            "skip_for_intranet": false
        },
        "auth": {
            "auth说明": "gRPC 鉴权。生产请用 allowlist/token/mtls，禁止 skip_for_intranet",
            "mode": "none",
            "allowlist": [],
            "token": ""
        }
    },
    "telegram": {
        "telegram说明": "Telegram 机器人配置（可选，不填 Cfg.Telegram 为 nil 则不启用）",
        "bot_token": "000000:CHANGE-ME",
        "game_url": "https://t.me/your_bot?start=",
        "game_banner_url": "https://example.com/banner.png",
        "game_description": "游戏简介",
        "game_to_short": {
            "game_1": "g1",
            "game_2": "g2"
        }
    },
    "lua_config": {
        "lua_config说明": "Lua 运行时详细配置，需配合顶层 lua 字段指向脚本路径使用",
        "script_path": "lua/main.lua",
        "enable": "on",
        "update_interval": 5000,
        "gc_tick_count": 1000,
        "max_memory_mb": 128
    },
    "server": {
        "server说明": "服务器全局配置",
        "debug": false,
        "fps": 30,
        "version": "1.0.0",
        "max_msg_size": 1048576,
        "write_buffer": 4096,
        "read_buffer": 4096,
        "backpressure": true
    },
    "metrics": {
        "metrics说明": "Prometheus 监控配置",
        "enabled": false,
        "port": 9090,
        "token": ""
    },
    "model_api": {
        "model_api说明": "模型API接入配置（OpenAI 兼容接口，可选，不填则不启用；支持多个提供方，每个提供方可配置多个模型，enable=off 也可关闭）",
        "enable": "on",
        "default说明": "默认提供方名，多个提供方时必填",
        "default": "openai",
        "strategy说明": "模型选择策略：default=使用默认提供方的默认模型；cheapest=按请求预估消费自动选择最省钱的模型（先按 priority 分层，层内无价格模型优先、其余选最省）",
        "strategy": "cheapest",
        "price_source说明": "在线价格源（可选；模型未配置本地价格时自动查询；不配置此段则不获取在线价格）：provider=litellm/openrouter/off(关闭)；url 可覆盖默认地址；cache_ttl=价格缓存秒数(默认86400)；timeout=拉取超时秒数(默认10)",
        "price_source": {
            "provider": "litellm",
            "cache_ttl": 86400,
            "timeout": 10
        },
        "providers": {
            "openai": {
                "base_url": "https://api.openai.com/v1",
                "api_key": "sk-CHANGE-ME",
                "model说明": "默认模型名；models 非空时须为其一，为空时取 models 第一项",
                "model": "gpt-4o-mini",
                "timeout": 60,
                "max_retries": 2,
                "max_concurrency说明": "提供方级默认最大并发在途请求数（cheapest 自动选型时达到即溢出到下一个模型），0=不限；模型级优先",
                "max_concurrency": 20,
                "rpm_limit说明": "提供方级默认每分钟最大请求数，0=不限；模型级优先",
                "rpm_limit": 300,
                "models说明": "该提供方的模型列表（价格单位：美元/百万 token，留 0 可由在线价格源补齐；priority=数字越小越优先；max_concurrency/rpm_limit=模型级压力阈值；supports_tools=是否支持函数调用）",
                "models": [
                    {
                        "name": "gpt-4o-mini",
                        "input_price": 0.15,
                        "output_price": 0.6,
                        "priority": 1,
                        "supports_tools": true
                    },
                    {
                        "name": "gpt-4o",
                        "input_price": 2.5,
                        "output_price": 10,
                        "priority": 2,
                        "max_concurrency": 5,
                        "rpm_limit": 60,
                        "supports_tools": true
                    }
                ]
            },
            "deepseek": {
                "base_url": "https://api.deepseek.com/v1",
                "api_key": "sk-CHANGE-ME",
                "model": "deepseek-chat",
                "models": [
                    {
                        "name": "deepseek-chat",
                        "input_price": 0.27,
                        "output_price": 1.1,
                        "priority": 1,
                        "supports_tools": true
                    }
                ]
            }
        }
    },
    "log_level": "日志等级,off为不开,其次为INFO,DEBUG,WARN,ERROR",
    "map_path": "off"
}
