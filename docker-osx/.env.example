# 复制为 .env 后按需修改；docker compose 会自动读取与本文件同目录的 .env。
# 不建 .env 也能跑，所有项都有内置默认值。

# ---- 系统盘 ----
# 仅首次创建 mac_hdd_ng.img 时生效；已有系统盘不会自动扩容
SIZE=200G
# 安装哪个 macOS 版本（改后需删除旧 BaseSystem.img 才会重新下载）
SHORTNAME=tahoe

# ---- 宿主机端口 ----
# BIND_ADDR: WSL2 内跑 docker-ce 时保持 0.0.0.0（WSL 是 NAT，局域网进不来）；
#            用 Docker Desktop 时建议改 127.0.0.1（端口直接发布在 Windows 宿主上）
BIND_ADDR=0.0.0.0
HOST_SSH_PORT=50922
HOST_SCREEN_SHARE_PORT=5900
HOST_VNC_PORT=5999

# ---- 虚拟机资源 ----
# SMP/CORES 为 half 时按真机 nproc/2 自动计算（不写死核数，换机器不用改）
RAM=8
SMP=half
CORES=half
# 容器级 CPU 硬限额（单位=核）。不填时 start.sh 自动设为真机一半；
# 直接 docker compose up 且此处留空则回落到 4。写死数字即覆盖自动计算。
# CPU_LIMIT=8

# ---- 构建 ----
# 非空即启用按速度排序 Arch 镜像源（慢网建议 true）
RANKMIRRORS=

# ---- USB 透传（留空不接）----
# hostbus=1,hostaddr=5   或   vendorid=0x05ac,productid=0x12a8
USB_DEVICE=

# ---- 下载 macOS 安装器用的代理（留空直连）----
# WSL 里 127.0.0.1 是 distro 自己，用不了 Windows 上的 127.0.0.1:7890。
# 取 Windows 宿主 IP（WSL 内 `ip route show default | awk '{print $3}'`），
# 并确认代理软件已开「允许局域网连接」。
# CONTAINER_HTTP_PROXY=http://172.29.240.1:7890
CONTAINER_HTTP_PROXY=
CONTAINER_NO_PROXY=localhost,127.0.0.1

# ---- 高级项（一般不用改，默认值见 docker-compose.yml）----
# AUDIO_DRIVER=auto
# CPU=Skylake-Client
# GENERATE_UNIQUE=false
# SHARE_TAG=hostshare
# SHARE_SECURITY_MODEL=passthrough
