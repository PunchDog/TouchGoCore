# Zalo 卡片真机探针环境模板
#
# 复制为 probe.env 后填写：
#   cp zalo/probe/env.example zalo/probe/probe.env
#   powershell -File zalo/probe/run.ps1        # Windows
#   bash zalo/probe/run.sh                     # Linux / macOS / Git Bash
#
# probe.env 已被 .gitignore 忽略，不会入库。
# 警告：探针会真实发送一条消息，务必指向测试账号与测试会话。

# 必填：Postgres DSN。探针只读 zalo_sessions 表，不会写库；口令不要提交。
TEST_ZALO_PROBE_DSN=postgres://user:pass@127.0.0.1:5432/zalo?sslmode=disable

# 必填：已登录的 Zalo 账号 ID（与 zalo_sessions 里的 account 标识一致）
TEST_ZALO_PROBE_ACCOUNT=acct-demo

# 必填：收件人。单聊填用户 UID；群聊填群 ID（并设置 TEST_ZALO_PROBE_GROUP=1）
TEST_ZALO_PROBE_TO=1234567890

# 必填：卡片外链。卡片缩略图/标题/描述由该页面的 OG 元数据决定，必须公网可访问。
TEST_ZALO_PROBE_LINK=https://example.com/landing

# 可选：卡片文字。留空使用探针内置文案。
TEST_ZALO_PROBE_TEXT=Zalo 卡片探针

# 可选：1 = 发到群；0/留空 = 单聊
TEST_ZALO_PROBE_GROUP=0
